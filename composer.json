{
    "name": "mj-zana/idempotency",
    "description": "Idempotency keys for Zana HTTP routes: a retried request gets the stored response instead of running twice",
    "type": "library",
    "keywords": [
        "zana",
        "idempotency",
        "idempotency-key",
        "http",
        "middleware",
        "payments"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.11",
        "mj-zana/database": "^2.12",
        "mj-zana/http": "^2.10",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "mj-zana/console": "^2.0",
        "mj-zana/routing": "^2.0",
        "mj-zana/security": "^2.0",
        "mj-zana/session": "^2.0",
        "mj-zana/testing": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "mj-zana/security": "Scopes keys to the signed-in user",
        "mj-zana/session": "Scopes an anonymous visitor's keys to their session, not only their address",
        "mj-zana/routing": "Lets check find #[Idempotent] handlers whose route lacks the middleware",
        "mj-zana/console": "For idempotency:install and idempotency:prune"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Idempotency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Idempotency\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures.php"
        ]
    },
    "repositories": [
